# ─── Turso (libSQL) ────────────────────────────────────────────────────────
# turso db create fit-coach
# turso db show fit-coach --url   /   turso db tokens create fit-coach
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional local embedded replica file for low-latency reads.
TURSO_EMBEDDED_REPLICA_PATH=

# ─── Better Auth ───────────────────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Local: http://localhost:3040 . Production: your Vercel URL
BETTER_AUTH_URL=http://localhost:3040
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3040
# Set to "true" to block new sign-ups.
AUTH_DISABLE_SIGNUPS=

# ─── Google OAuth (primary sign-in) ────────────────────────────────────────
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web).
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Email (OTP delivery) ──────────────────────────────────────────────────
# resend.com API key. Without it, OTP codes are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM=Fit Coach <onboarding@resend.dev>

# ─── AI coach (any OpenAI-compatible endpoint) ─────────────────────────────
# Without a key, the coach returns a deterministic rule-based summary and
# MD import is disabled. GROQ_API_KEY still works as a fallback for AI_API_KEY.
AI_API_KEY=
# Groq (free): https://api.groq.com/openai/v1 + openai/gpt-oss-120b
# Anthropic:   https://api.anthropic.com/v1 + claude-sonnet-5 (or claude-haiku-4-5)
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b

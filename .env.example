# ─── Postgres (Neon) ───────────────────────────────────────────────────────
# Local dev uses the Neon `dev` branch, never `main` (prod):
# neonctl connection-string dev --pooled   /   neonctl connection-string dev
# Prod credentials live only in Vercel env, never in a local .env file.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# DATABASE_URL is the pooled runtime connection as the app_rw role (row-level security applies).
# DATABASE_URL_UNPOOLED is the owner role, used only by migrations and backups.
# Use sslmode=verify-full in both URLs (node-postgres warns on sslmode=require).

# ─── Turso (libSQL), source for the one-time migration only ────────────────
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─── Better Auth ───────────────────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Local: http://localhost:3040 . Production: your Vercel URL
BETTER_AUTH_URL=http://localhost:3040
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3040
# Set to "true" to block new sign-ups.
AUTH_DISABLE_SIGNUPS=

# ─── Google OAuth (primary sign-in) ────────────────────────────────────────
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web).
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Background maintenance (Vercel Cron) ──────────────────────────────────
# openssl rand -hex 24 . Vercel sends this as a Bearer token automatically
# when the env var is set; the route rejects any request without it.
CRON_SECRET=

# ─── Credential encryption ─────────────────────────────────────────────────
# openssl rand -base64 32 . Encrypts stored AI provider keys (AES-256-GCM).
# Rotation: move the old key to INTEGRATIONS_ENC_KEY_OLD, set a new primary.
INTEGRATIONS_ENC_KEY=
INTEGRATIONS_ENC_KEY_OLD=

# ─── AI coach (text: Vercel AI SDK, per-user BYOK) ─────────────────────────
# No env var: each user stores their own provider (OpenRouter or Groq), API
# key and model in Settings > AI, encrypted with INTEGRATIONS_ENC_KEY.
# Without a key the coach falls back to a rule-based summary, MD import off.
# Vision (InBody sheet OCR). All three required, no defaults.
AI_VISION_API_KEY=
AI_VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_VISION_MODEL=gemini-2.5-flash

# Embeddings (coach long-term memory): a third provider slot, because Groq has
# no embedding model. Default: gemini-embedding-001 truncated to 768 dimensions
# via outputDimensionality, which must match EMBEDDING_DIM in lib/constants.ts
# and the F32_BLOB(n) column. Truncated vectors come back unnormalized, so the
# client normalizes them. A model with a different dimension needs a migration.
# Falls back to AI_VISION_API_KEY when AI_EMBEDDING_API_KEY unset, so rotating
# the vision key also rotates the embedding key (and therefore affects coach
# fact memory) unless AI_EMBEDDING_API_KEY is set explicitly.
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_EMBEDDING_MODEL=gemini-embedding-001

# Tool gate (optional). When JEV_API_KEY is set, every direct coach write
# (meals, fatigue, workouts, measurements, rules) is judged by TypeSafe Jev
# before it runs: a clear match runs, a write the user did not ask for is
# refused, a doubtful one shows the confirmation card. Unset, or Jev not
# reachable within 3 s: writes run exactly as they do without the gate.
# Jev on OpenRouter is paid per call (about USD 0.00002 per decision).
JEV_API_KEY=
JEV_BASE_URL=https://openrouter.ai/api/v1
JEV_MODEL=typesafe/jev-1.13
# Minimum probability to auto-run (approve) or auto-refuse (deny), 0 to 1.
JEV_APPROVE_MIN=0.7
JEV_DENY_MIN=0.7

# ─── Web push (coach notifications) ────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: address web-push includes in the VAPID JWT, required by the spec.
VAPID_SUBJECT=mailto:you@example.com
# Same value as VAPID_PUBLIC_KEY, exposed to the client subscribe call.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# PostHog analytics (production only). Leave empty to disable.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
